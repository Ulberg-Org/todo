<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Server.fs" />
    <Compile Include="ApiTests.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../db/init/*.sql" LinkBase="db/init" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Expecto" Version="11.1.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.17.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Todo.Api/Todo.Api.fsproj" />
  </ItemGroup>
</Project>
